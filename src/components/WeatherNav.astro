---
export const prerender = false;
import { Icon } from "astro-icon/components";

const { dayPhase, weather, myIcon } = Astro.props;

let myWeatherNav = "nav-lt-mode";
let navWeatherIcon = "nav-weather-icon";

if((dayPhase === "morning") || (dayPhase === "dawn") || (dayPhase === "afternoon")) {
    myWeatherNav = "nav-lt-mode";
} else if((dayPhase === "night") || (dayPhase === "dusk")) {
    myWeatherNav = "nav-dk-mode";
}

---

<nav class={myWeatherNav}>
    <ul>
        <li>
            <a href="/about">about</a>
        </li>
        <li>
            <p>time calc: {dayPhase}</p>
            <p>weather calc: {weather}</p>
        </li>
        <li>
            <Icon name={myIcon} class="nav-weather-icon" />
        </li>
    </ul>
</nav>

<style>
    ul {
        display: flex;
        align-items: start;
        gap: 3ch;
    }

    li {
        list-style: none;
    }
</style>