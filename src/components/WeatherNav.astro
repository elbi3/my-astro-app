---
export const prerender = false;
import { Icon } from "astro-icon/components";

const { dayPhase, weather, myIcon } = Astro.props;
---

<nav>
    <ul>
        <li>
            <a href="/about">about</a>
        </li>
        <li>
            <p>time calc: {dayPhase}</p>
            <p>weather calc: {weather}</p>
        </li>
        <li>
            <Icon name={myIcon} class="nav-weather-icon" />
        </li>
    </ul>
</nav>

<style>
    ul {
        display: flex;
        align-items: start;
        gap: 3ch;
    }

    li {
        list-style: none;
    }
</style>