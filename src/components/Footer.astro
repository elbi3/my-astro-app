---
import { Icon } from "astro-icon/components";

const { dayPhase } = Astro.props;
let myWeatherNav = "nav-lt-mode";
let navWeatherIcon = "nav-weather-icon";

if((dayPhase === "morning") || (dayPhase === "dawn") || (dayPhase === "afternoon")) {
    myWeatherNav = "nav-lt-mode";
} else if((dayPhase === "night") || (dayPhase === "dusk")) {
    myWeatherNav = "nav-dk-mode";
}
---

<footer class={myWeatherNav}>
    <ul>
        <li>
            <a href="https://github.com/elbi3"><Icon name="mdi:github" class="a-tag-icon" /></a>
        </li>
        <li>
            <a href="https://www.linkedin.com/in/el-brewster/"><Icon name="mdi:linkedin" class="a-tag-icon"/></a>
        </li>
    </ul>
</footer>

<style>
    ul {
        display: flex;
        align-items: start;
        gap: 3ch;
    }

    li {
        list-style: none;
    }
</style>