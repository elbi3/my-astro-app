---
//for "main page" content, `BaseLayout` holds API call reference, and html meta
// export const prerender = false;//necessary for server-side fetch() for HTML and SSR logic in Astro frontmatter
import { Icon } from "astro-icon/components";
import Dice from "../components/Dice.vue";
import "../assets/styles/test.css"

let weather = "clear";
let dayPhase = "morning";
// let myIcon = "mdi:weather-sunny"
let dataPolarity = "dark";

const WEATHER_ICONS = {
	clear: "mdi:weather-sunny",
	cloudy: "mdi:weather-cloudy",
	wet: "mdi:weather-rainy",
	storm: "mdi:weather-lightning",
	snow: "mdi:weather-snowy",
	fog: "mdi:weather-fog",
};

let myIcon = WEATHER_ICONS[weather];
---

<!doctype html>
<html lang="en" data-weather={weather} data-time={dayPhase} data-polarity={dataPolarity}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Plant Kennel</title>
	</head>
	<body>
		<header class="home-header surface">
            <Dice client:visible />
            <h1>Plant Kennel</h1>
        </header>
		<nav class="home-nav surface frame">
			<ul>
				<li>
					<a href="/about">about</a>
                    <a href="/css-colors/">color ratio tool</a>
				</li>
				<li>
					<p>time calc: {dayPhase}</p>
					<p>weather calc: {weather}</p>
				</li>
				<li>
					<Icon name={myIcon} class="nav-weather-icon" />
				</li>
			</ul>
		</nav>
        <main class="my-main">
            <section>
                <div class="toolbox">
                <h2>TOOLBOX</h2>
                <p><a href="/css-colors/">color ratio tool</a></p>
            </div>
            </section>
            <section>
                <h2>weather stuff</h2>
            </section>
        </main>
        <footer class="home-footer surface frame">
            <ul>
                <li>
                    <a href="https://github.com/elbi3"><Icon name="mdi:github" class="a-tag-icon" /></a>
                </li>
                <li>
                    <a href="https://www.linkedin.com/in/el-brewster/"><Icon name="mdi:linkedin" class="a-tag-icon"/></a>
                </li>
            </ul>
        </footer>
	</body>
</html>
